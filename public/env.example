# ============================================
# CARRÉ GYM — VARIABLES D'ENVIRONNEMENT
# ============================================
# NE JAMAIS COMMITTER CE FICHIER AVEC DES VRAIES VALEURS !
# Utilisez un gestionnaire de secrets en production (Render, Railway, etc.)

# ============================================
# AUTHENTIFICATION (OBLIGATOIRE)
# ============================================
# Mot de passe administrateur (min 8 caractères)
ADMIN_PASSWORD=votre-mot-de-passe-ultra-securise-ici

# Clé secrète JWT (min 32 caractères, générée aléatoirement)
# Générez avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre-cle-super-secrete-de-64-caracteres-minimum-obligatoire

# ============================================
# EMAIL (OPTIONNEL — emails désactivés si manquant)
# ============================================
# Clé API Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse email de notification
EMAIL_TO=admin@carregym.dz

# URL du tableau de bord (pour les liens dans les emails)
ADMIN_URL=https://votre-domaine.onrender.com/admin

# ============================================
# CORS (OPTIONNEL)
# ============================================
# Origines autorisées, séparées par des virgules
# Laissez vide pour autoriser toutes les origines (déconseillé en production)
ALLOWED_ORIGINS=https://votre-domaine.onrender.com

# ============================================
# SERVEUR (OPTIONNEL)
# ============================================
PORT=3000
